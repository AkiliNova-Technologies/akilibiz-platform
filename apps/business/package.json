{
  "name": "@akilibiz/business-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "verify:hosted-rls": "node --env-file=.env.hosted-rls scripts/verify-hosted-rls.mjs",
    "qualify:phase1c": "node scripts/qualify-phase1c-hosted.mjs",
    "verify:sync-security": "node scripts/check-sync-security-posture.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:introspect": "prisma db pull --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma"
  },
